<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Runner hedefinin Debug, Profile ve Release ayarlarına bağlıdır.
  Cihaz derlemeleri için Apple tarafından onaylanmış CarPlay Audio yetkisini
  içeren provisioning profili gerekir. Kurulum: docs/CARPLAY_KURULUM.md
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.carplay-audio</key>
	<true/>
</dict>
</plist>
